rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId != null &&
        (
          coupleId == request.auth.uid + '_' + get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId ||
          coupleId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerId + '_' + request.auth.uid
        );
    }

    // ==========================================
    // 1. Users Profile Collection (/users/{userId})
    // ==========================================
    match /users/{userId} {
      // 1. Authenticated user can read their own profile (request.auth.uid == userId)
      // 2. Paired partner can read profile (resource.data.partnerId == request.auth.uid)
      // 3. Potential partner can read during pairing handshake (!resource.data.isPaired)
      allow get: if isAuthenticated() && (
        request.auth.uid == userId ||
        (resource != null && (resource.data.partnerId == request.auth.uid || resource.data.isPaired == false))
      );

      // Strict privacy: Disallow collection-wide queries or bulk user listing
      allow list: if false;

      // Authenticated user can create their own initial profile document
      allow create: if isOwner(userId);

      // Authenticated user can update their own profile;
      // Partner can ONLY update mutual pairing status fields (isPaired, partnerId, partnerName, pairedAt)
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPaired', 'partnerId', 'partnerName', 'pairedAt']) &&
          (resource.data.partnerId == request.auth.uid || resource.data.partnerId == null || resource.data.isPaired == false)
        )
      );

      // Only owner can delete their own profile
      allow delete: if isOwner(userId);
    }

    // ====================================================
    // 2. Pairing Codes Index Collection (/pairing_codes/{code})
    // ====================================================
    match /pairing_codes/{code} {
      // Authenticated users can query a single target pairing code document
      allow get: if isAuthenticated();

      // Strict privacy: Disallow listing all pairing codes
      allow list: if false;

      // Only the user themselves can register or update their own pairing code
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Only the owner can remove or delete their pairing code
      allow delete: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
    // ====================================================
    // 3. Couple shared data (/couples/{coupleId})
    // ====================================================
    match /couples/{coupleId} {
      allow read, write: if isCoupleMember(coupleId);

      match /{document=**} {
        allow read, write: if isCoupleMember(coupleId);
      }
    }

  }
}
